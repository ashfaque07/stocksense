# Copy to .env and fill in. Never commit real keys.

# AI providers (OpenAI-compatible). A provider is active only if its API key
# AND models are set.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODELS=nvidia/llama-3.3-nemotron-super-49b-v1,meta/llama-3.3-70b-instruct

PORT=8787

# --- Auto trading ---
# Required to call /api/trades, /api/trade-run, /api/trade-token (x-admin-key header).
TRADE_ADMIN_KEY=
# Static-IP VM relay that forwards orders to Upstox.
VM_RELAY_URL=
VM_RELAY_SECRET=
# Scheduler on/off. Paper mode records trades without calling Upstox; use "live" for real orders.
AUTO_TRADE_ENABLED=false
AUTO_TRADE_MODE=paper
# Postgres connection string (Netlify DB sets NETLIFY_DATABASE_URL automatically on Netlify).
DATABASE_URL=

# Optional overrides (defaults shown)
# AUTO_TRADE_CAPITAL=1000
# AUTO_TRADE_MAX_POSITIONS=3
# AUTO_TRADE_SL_PERCENT=5
# AUTO_TRADE_TARGET_PERCENT=3
# AUTO_TRADE_STAGES=IMMINENT,COILING

# The Upstox access token expires daily: paste it on the Auto Trading page, not here.
